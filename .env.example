# Copy to .env and fill in. NEVER commit .env.
# Get paper keys at https://app.alpaca.markets/paper/dashboard/overview after signing up.

ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET=your_paper_secret_here
# Informational only — alpaca-py picks the right URL from `paper=True/False`.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Equity bar data feed.
#   iex         = real-time IEX-exchange only (free Basic plan — DEFAULT)
#   sip         = real-time full tape (Algo Trader Plus, $99/mo)
#   delayed_sip = 15-min delayed full tape (requires paid plan to enable)
EQUITY_DATA_FEED=iex

# Trading mode: "paper" (default, safe) or "live" (real money — only after paper proves out).
TRADING_MODE=paper

# Database (SQLite path, relative to repo root).
DB_PATH=tradingbot.db

# Risk caps — override only with reason.
MAX_POSITION_PCT=0.05
MAX_CONCURRENT_POSITIONS=3
DAILY_LOSS_LIMIT_PCT=0.02
TOTAL_DD_LIMIT_PCT=0.10

# Loop tuning.
POLL_INTERVAL_SECONDS=15
CLOCK_SKEW_MAX_SECONDS=5
EQUITY_DRIFT_MAX_PCT=0.01

# Logging.
LOG_LEVEL=INFO
LOG_DIR=logs
