[Unit]
Description=tradingBot post-week review (runs scripts/post_week_review.sh)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# %h = the running user's home directory. Adjust subpath if the repo lives elsewhere.
WorkingDirectory=%h/code/tradingBot
ExecStart=%h/code/tradingBot/scripts/post_week_review.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tradingbot-review
