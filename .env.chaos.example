# Copy to .env.chaos (gitignored) and fill in NEW Alpaca paper API keys.
#
# Track B requires a SEPARATE Alpaca paper account from Track A so the chaos bot's
# trades don't contaminate Track A's evidence. Create one at:
#   https://app.alpaca.markets/paper/dashboard
# (Alpaca lets you create multiple paper accounts under one login — use a new one.)

ALPACA_API_KEY=your_new_chaos_paper_key_here
ALPACA_SECRET=your_new_chaos_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

EQUITY_DATA_FEED=iex
TRADING_MODE=paper

# Separate SQLite file so Track A and Track B audit logs stay independent.
DB_PATH=tradingbot-chaos.db

# CHAOS risk caps — deliberately looser than Track A. We're trading paper money
# on a separate account; the point is to test aggressive sizing without touching
# the real-money path.
MAX_POSITION_PCT=0.25
MAX_CONCURRENT_POSITIONS=2
DAILY_LOSS_LIMIT_PCT=0.05
TOTAL_DD_LIMIT_PCT=0.25

POLL_INTERVAL_SECONDS=15
CLOCK_SKEW_MAX_SECONDS=5
EQUITY_DRIFT_MAX_PCT=0.01

LOG_LEVEL=INFO
LOG_DIR=logs
